# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=corretor_prova_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corretor_prova_db

# Cache / Queue (Redis)
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379

# API
PORT=3333
HOST=0.0.0.0
NODE_ENV=dev
TRUST_PROXY=false

# Auth (Better Auth)
BETTER_AUTH_SECRET=minha-chave-secreta-dev
BETTER_AUTH_URL=http://localhost:3333
WEB_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM="Corretor de Prova IA <onboarding@resend.dev>"

# AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
