{
	"$schema": "https://json.schemastore.org/tsconfig",
	"_version": "24.0.0",
	"compilerOptions": {
		"lib": [
			"es2024",
			"ESNext.Array",
			"ESNext.Collection",
			"ESNext.Error",
			"ESNext.Iterator",
			"ESNext.Promise"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "es2024",
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	}
}
